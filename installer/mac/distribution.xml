<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Chupa Loops</title>
    <organization>com.perception</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <allowed-os-versions>
        <os-version min="11.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>
    <choice id="vst3" title="VST3 plug-in" description="For Fender Studio Pro, Cubase, Ableton Live, Bitwig, Reaper and other VST3 hosts.">
        <pkg-ref id="com.perception.chupaloops.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit plug-in" description="For Logic Pro, GarageBand, Ableton Live and other AU hosts.">
        <pkg-ref id="com.perception.chupaloops.au"/>
    </choice>
    <choice id="app" title="Standalone app" description="Chupa Loops without a DAW, in your Applications folder.">
        <pkg-ref id="com.perception.chupaloops.app"/>
    </choice>
    <pkg-ref id="com.perception.chupaloops.vst3" version="@VERSION@">ChupaLoops-vst3.pkg</pkg-ref>
    <pkg-ref id="com.perception.chupaloops.au" version="@VERSION@">ChupaLoops-au.pkg</pkg-ref>
    <pkg-ref id="com.perception.chupaloops.app" version="@VERSION@">ChupaLoops-app.pkg</pkg-ref>
</installer-gui-script>
